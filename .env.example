# MetuPay — copy to .env and fill in. Everything here is read by Vite's server (vite.config.js);
# only FOID_CLIENT_ID and FOID_APP_URL reach the browser. The client secret never does.

# Your "Continue with FOID" app, from the FOID business console (https://admin-foid.pages.dev)
# → Apps → New app (Test). Test apps accept http://localhost on any port, so you don't need
# to add an allowed origin or redirect URI for local testing.
FOID_CLIENT_ID=
# Shown once when you create the app. Server-side only.
FOID_CLIENT_SECRET=

# Leave these two blank to use hosted FOID (the SDKs' defaults: https://foid-iy7u.onrender.com and
# https://usefoid.pages.dev). Only set them when running FOID on your own machine:
#   FOID_API_URL=http://localhost:8000
#   FOID_APP_URL=http://localhost:5173
FOID_API_URL=
FOID_APP_URL=
